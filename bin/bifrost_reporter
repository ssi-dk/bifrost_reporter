pd.set_option('display.max_columns', None)
pd.set_option('display.max_rows', None)
import shutil


def setup_logging(log_file):
    """
    Function to configure logging settings

    Parameters:
    ----------
    log_file : str
        The path of the log file where log messages will be written
    """
    logging.basicConfig(
        filename=log_file,
        level=logging.INFO,
        format="%(asctime)s - %(levelname)s - %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )


def parse_arguments():
    """
    Parses command-line arguments for the script.
    """
    parser = argparse.ArgumentParser(
        description="Bifrost Results Aggregator: Check sample files, parse result YAMLs, and merge analysis outputs."
    )
    parser.add_argument(
        "-c", "--config",
        required=True,
        help="Path to the environment YAML configuration file containing sample paths."
    )
    parser.add_argument(
        "-l", "--log",
        default="bifrost_results.log",
        help="Path to the log file (default: bifrost_results.log)."
    )
    return parser.parse_args()





if __name__ == '__main__':
    args = parse_arguments()

    # Set up logging
    setup_logging(args.log)

    # Load environment config
    config = get_config(args.config)

    # Load Thor Analysis
    HINF_df = pd.read_excel(config["hinf_mgk"]["path"], sheet_name = "HINF")
    MGK_df = pd.read_excel(config["hinf_mgk"]["path"], sheet_name="MGK")
    out_path1 = os.path.join(config["Nanopore"]["output"] ,"HINF_thor.tsv")
    out_path2 = os.path.join(config["Nanopore"]["output"] ,"MGK_thor.tsv")
    



    try:
        print("ILLUMINA")
        print("-----------------------------------------------------")
        # Retrieve sample paths from config
        new_illumina_paths = retrieve_samples(config["Illumina"]["new"])
        original_illumina_paths = retrieve_samples(config["Illumina"]["original"])
        
        # # Check for expected files in sample directories
        new_illumina = check_samples(new_illumina_paths,mode="illumina")
        original_data = check_samples(original_illumina_paths,mode="illumina") 

        # # Collect parsed data
        l_new_illumina = data_collection_from_dict(new_illumina,mode="illumina")
        l_og_illumina = data_collection_from_dict(original_data,mode="illumina")
        #print(l_new)
    except Exception as e:
        logging.error(f"Failed to retrieve or check Illumina sample data: {str(e)}")
        #raise SystemExit(f"Error loading sample paths or data collection failed: {e}")

    try:    
        print("NEW NANOPORE")
        print("-----------------------------------------------------")
        new_nanopore_paths = retrieve_samples(config["Nanopore"]["new"])
        new_nanopore = check_samples(new_nanopore_paths,mode="nanopore")
        l_new_nanopore = data_collection_from_dict(new_nanopore,mode="nanopore")

        print("ORIGINAL NANOPORE")
        print("-----------------------------------------------------")
        og_nanopore_paths = retrieve_samples(config["Nanopore"]["original"])
        og_nanopore = check_samples(og_nanopore_paths,mode="nanopore")
        l_og_nanopore = data_collection_from_dict(og_nanopore,mode="nanopore")


    except Exception as e:
        logging.error(f"Failed to retrieve or check Nanopore sample data: {str(e)}")


    # Organize new results by prefix
    l_dict_dfs = []
    for df in l_new_nanopore:
        try:
            df["Prefix"] = df.index.to_series().apply(extract_prefix)
            dict_dfs = {prefix: sub_df.drop(columns=["Prefix"]) for prefix, sub_df in df.groupby("Prefix")}
            l_dict_dfs.append(dict_dfs)
        except:
            continue
    
    
    nanostat_dict = {key: pd.concat([df, l_og_nanopore[0]]) for key, df in l_dict_dfs[0].items()}
    out_path = os.path.join(config["Nanopore"]["output"] ,"nanostat")
    if os.path.exists(out_path):
        shutil.rmtree(out_path)
    os.makedirs(out_path)

    for sample in nanostat_dict:
        out_name = sample + "_NanoStat.tsv"
        nanostat_dict[sample].to_csv(os.path.join(out_path, out_name), sep="\t")


    mlst_dict = {key: pd.concat([df, l_og_nanopore[1]]) for key, df in l_dict_dfs[1].items()}
    out_path = os.path.join(config["Nanopore"]["output"] ,"mlst")
    if os.path.exists(out_path):
        shutil.rmtree(out_path)
